# ── Email provider ────────────────────────────────────────────────────────────
# Options: mock (default, zero network) | mailtrap | broken (Test 6 only)
EMAIL_PROVIDER=mock

# ── Mailtrap sandbox credentials (only needed when EMAIL_PROVIDER=mailtrap) ──
# Sign up free at https://mailtrap.io → My Inbox → SMTP Settings
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password
MAILTRAP_FROM=noreply@college-automation.local

# ── Calendar provider ─────────────────────────────────────────────────────────
# Options: mock (default) | broken (Test 6 only)
CALENDAR_PROVIDER=mock

# ── Backend (Member 1) ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── AI Service (Member 2) ────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── Notion (Member 3) ────────────────────────────────────────────────────────
NOTION_API_KEY=secret_your_notion_integration_token
NOTION_REQUESTS_DB_ID=your_requests_database_id
NOTION_RUNLOG_DB_ID=your_runlog_database_id
NOTION_APPROVALS_DB_ID=your_approvals_database_id

# ── Test flags ────────────────────────────────────────────────────────────────
# Set to "1" to skip tests that require live services (for pure offline CI)
SKIP_LIVE_SERVICES=0
