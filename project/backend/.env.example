# ─────────────────────────────────────────────────────────────
# AI College Request Automation — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME="AI College Request Automation"
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Database ──────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./college_requests.db
# PostgreSQL (production) — swap to this and no code changes needed:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/college_requests

# ── AI Microservice ───────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001   # base URL of the AI classification service
AI_SERVICE_TIMEOUT_SECONDS=5           # per-request timeout
AI_SERVICE_MAX_RETRIES=2               # max retry attempts on timeout/5xx

# ── Notion ────────────────────────────────────────────────────
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REQUESTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Requests DB
NOTION_RUNLOG_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # Run Log DB
NOTION_APPROVALS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Approvals DB

# ── Approval Polling ──────────────────────────────────────────
APPROVAL_POLL_INTERVAL_SECONDS=7      # how often to poll Notion for a decision
APPROVAL_POLL_MAX_WAIT_SECONDS=3600   # give up after this many seconds (1 hour)

# ── Idempotency ───────────────────────────────────────────────
IDEMPOTENCY_WINDOW_SECONDS=300        # 5-minute dedup window

# ── Input Validation ─────────────────────────────────────────
REQUEST_TEXT_MAX_LENGTH=5000
