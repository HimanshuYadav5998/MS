# ─────────────────────────────────────────────────────────
# AI Service — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── LLM API Configuration ────────────────────────────────
# Your OpenAI (or OpenAI-compatible) API key.
# If left blank, the service falls back to the offline rule-based classifier.
LLM_API_KEY=

# Base URL of the OpenAI-compatible API.
# Default: OpenAI's production endpoint.
# Override for local models (e.g., Ollama: http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1

# Model to use for classification.
# gpt-4o-mini is a good balance of speed, cost, and accuracy for this task.
LLM_MODEL=gpt-4o-mini

# Request timeout in seconds. Increase if using a slower/local model.
LLM_TIMEOUT_SEC=15

# Maximum tokens in the LLM response (JSON is short, 512 is ample).
LLM_MAX_TOKENS=512

# Temperature (0.0 = deterministic, preferred for structured extraction).
LLM_TEMPERATURE=0.1

# ── Service Configuration ─────────────────────────────────
# Port is hard-coded to 8001 in main.py; override here if needed.
# PORT=8001
