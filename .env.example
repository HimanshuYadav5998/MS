# =============================================================================
# Notion Integration Environment Configuration
# AI College Request Automation
# =============================================================================

# Your Notion Internal Integration Secret Token (from https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_your_notion_integration_token_here

# (Optional - Used by setup_workspace.py) The Page ID where the workspace is created
NOTION_PARENT_PAGE_ID=your_parent_page_id_here

# Database IDs generated by running `python notion/setup_workspace.py`
NOTION_REQUESTS_DB_ID=your_requests_database_id_here
NOTION_RUNLOG_DB_ID=your_runlog_database_id_here
NOTION_APPROVALS_DB_ID=your_approvals_database_id_here

# (Optional) Operations Hub Home Page ID
NOTION_HUB_PAGE_ID=your_hub_page_id_here
